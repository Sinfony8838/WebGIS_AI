    {
      "id": "kb_hu_line",
      "title": "胡焕庸线",
      "topic": "population_distribution",
      "region": "china",
      "time": "2020",
      "status": "knowledge_only",
      "source": "builtin_teaching_card",
      "license": "teaching_only",
      "grade_level": "middle_school",
      "keywords": ["胡焕庸线", "人口地理分界线", "黑河腾冲线", "东密西疏", "人口差异"],
      "tags": ["人口", "区域差异", "读图"],
      "crs": "EPSG:4326",
      "summary": "胡焕庸线是解释中国人口东南密集、西北稀疏格局的经典人口地理分界线。",
      "canonical_answer": "胡焕庸线东南侧地形较平坦、季风气候条件较好，开发历史较早，城市、产业和交通网络也更密集；西北侧多高原、山地和干旱区，生态承载力与交通可达性相对受限，因此两侧人口密度差异显著。",
      "teaching_points": ["先识别线两侧人口密度差异。", "再从自然条件和社会经济条件解释。", "强调该线是统计格局参照，不是行政边界。"],
      "citations": [{"title": "国家统计局", "url": "https://www.stats.gov.cn/"}],
      "dataset_refs": [],
      "materials": [],
      "related_templates": ["hu_line_comparison"],
      "updated_at": "2026-07-10T00:00:00+08:00"
    },
    {
      "id": "kb_population_density",
      "title": "人口密度",
      "topic": "population_density",
      "region": "china",
      "time": "2020",
      "status": "knowledge_only",
      "source": "builtin_teaching_card",
      "license": "teaching_only",
      "grade_level": "middle_school",
      "keywords": ["人口密度", "人口分布", "区域差异", "每平方千米"],
      "tags": ["人口", "统计指标", "读图"],
      "crs": "EPSG:4326",
      "summary": "人口密度表示单位面积上的人口数量，用于比较不同地区人口分布的疏密程度。",
      "canonical_answer": "人口总量回答一个地区有多少人，人口密度则用地区总人口除以土地面积，回答单位面积上的人口疏密。两者不能互相替代：总量大不一定密度高，密度高也不必然意味着总量更大。比较时还应保持统计年份、人口口径和行政单元尺度一致。",
      "teaching_points": ["先区分人口总量与人口密度。", "明确人口密度的单位。", "比较时保持年份、人口口径和统计尺度一致。", "结合地形、气候、产业和交通解释空间差异。"],
      "citations": [{"title": "国家统计局", "url": "https://www.stats.gov.cn/"}],
      "dataset_refs": [],
      "materials": [],
      "related_templates": ["population_density"],
      "updated_at": "2026-07-10T00:00:00+08:00"
    },
    {
      "id": "kb_population_migration_flow",
      "title": "人口迁移流线判读",
      "topic": "population_migration",
      "region": "general",
      "time": "",
      "status": "knowledge_only",
      "source": "builtin_teaching_card",
      "license": "teaching_only",
      "grade_level": "middle_school",
      "keywords": ["人口迁移流线", "迁入", "迁出", "净迁移", "净迁入"],
      "tags": ["人口迁移", "流线图", "统计指标"],
      "crs": "",
      "summary": "人口迁移流线需要结合图例、方向、起讫点和统计口径判读，单向流线不能直接代表净迁入。",
      "canonical_answer": "只有图例明确规定线宽表示迁移人数时，粗线才表示该条起讫路径的迁移规模更大。净迁入等于全部迁入量减去全部迁出量，必须同时掌握双向流量、统计时期和人口口径；单向流线或示意流线不能直接用于判断净迁入。",
      "teaching_points": ["先读图例和箭头方向。", "区分单条迁移规模与地区全部迁入量。", "判断净迁移必须同时比较迁入与迁出。", "示意流线不能当作官方统计值。"],
      "citations": [],
      "dataset_refs": [],
      "materials": [],
      "related_templates": ["population_migration"],
      "updated_at": "2026-08-16T00:00:00+08:00"
    },
