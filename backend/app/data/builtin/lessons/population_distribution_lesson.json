          "expected_points": ["地势低平、气候湿润", "农业基础好", "交通城市密集、经济发达"],
          "misconceptions": [
            {"tag": "单因素解释", "description": "只用一个因素（如只有气候）解释，缺少自然+人文的综合视角"}
          ]
        }
      ],
      "assistant_prompts": ["请根据当前地图提出一个追问，引导学生解释胡焕庸线两侧人口差异。"]
    },
