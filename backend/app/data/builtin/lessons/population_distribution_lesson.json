      "script": [
        "现在我们打开胡焕庸线。请注意，这条线不是孤立的人口线，它背后反映了自然环境和区域发展的长期差异。",
        "胡焕庸线两侧人口分布有什么明显差异？这条线也反映了哪些自然环境差异？"
      ],
      "questions": [
        {
          "question_id": "s4q1",
          "type": "choice",
          "text": "胡焕庸线东南侧约占国土面积 43%，人口大约占全国的多少？",
          "options": ["约 50%", "约 70%", "约 94%", "约 30%"],
          "answer_index": 2,
          "expected_points": ["东南侧人口高度集中"],
          "misconceptions": [
            {"tag": "面积决定人口", "description": "认为面积越大的一侧人口一定越多，忽略自然与经济条件"}
          ]
        },
        {
          "question_id": "s4q2",
          "type": "open",
          "text": "东南侧为什么更容易形成人口集聚？",
          "options": [],
