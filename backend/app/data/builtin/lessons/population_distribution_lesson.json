{
  "lesson_id": "lesson_builtin_population_distribution",
  "title": "人口分布：中国人口的空间格局与胡焕庸线",
  "subject": "地理",
  "grade": "高中必修二 第一章第一节",
  "source": "builtin",
  "objectives": [
    "借助人口专题图层，描述中国人口分布的基本特点",
    "掌握“总体格局-高低值区域-分界线-影响因素”的四步描述框架",
    "结合自然与人文因素，解释中国人口东南多、西北少的原因",
    "通过图层观察、指标查询、地图标注与截图输出，形成地理实践成果"
  ],
  "metadata": {
    "duration_minutes": 40,
    "reference": "人教版高中地理必修二《人口分布》",
    "design_note": "免配准版：课堂证据只使用内置矢量图层、指标查询、标注与截图，不依赖图片覆盖层。",
    "builtin_version": "2"
  },
  "stages": [
    {
      "stage_id": "s1",
      "title": "问题导入：人口分布均匀吗",
      "minutes": 3,
      "scene": {
        "basemap_id": "amap_light",
        "templates": ["population_distribution"],
        "layer_visibility": {
          "builtin_population_regions": true,
          "builtin_population_density": false,
          "builtin_population_migration": false,
          "generated_hu_line": false
        },
        "view": {"center": [104.0, 35.0], "zoom": 4},
        "annotations": [],
        "visual_query": null
      },
      "script": [
        "今天我们不先背结论，而是先看地图。请大家观察人口分布图：中国人口是均匀分布的吗？",
        "如果人口是均匀分布的，这张地图应该是什么样子？"
      ],
      "questions": [
        {
          "question_id": "s1q1",
          "type": "choice",
          "text": "观察当前人口分布图，中国人口分布的总体特征是？",
          "options": ["大致均匀分布", "东南部稠密、西北部稀疏", "西北部稠密、东南部稀疏", "只集中在沿海城市"],
          "answer_index": 1,
          "expected_points": ["分布不均", "东多西少", "沿海、平原集中"],
          "misconceptions": [
            {"tag": "只见城市不见格局", "description": "只注意到个别大城市，没有形成东南-西北的整体格局认识"}
          ]
        }
      ],
      "assistant_prompts": ["请结合当前人口分布图层，用一句课堂语言概括中国人口分布的总体特征。"]
    },
    {
      "stage_id": "s2",
      "title": "概念建构：人口分布与人口密度",
      "minutes": 4,
      "scene": {
        "basemap_id": "amap_light",
        "templates": ["population_distribution", "population_density"],
        "layer_visibility": {
          "builtin_population_regions": false,
          "builtin_population_density": true,
          "builtin_population_migration": false,
          "generated_hu_line": false
        },
        "view": {"center": [104.0, 35.0], "zoom": 4},
        "annotations": [
          {"text": "人口较稠密", "position": [117.2, 32.0]},
          {"text": "人口较稀疏", "position": [85.0, 40.5]}
        ],
        "visual_query": null
      },
      "script": [
        "人口分布是集散状况，人口密度是平均每平方千米的人口数。",
        "人口数量是绝对量，容易受区域面积影响；人口密度是相对量，更适合比较不同地区的人口疏密。"
      ],
      "questions": [
        {
          "question_id": "s2q1",
          "type": "open",
          "text": "为什么比较不同地区人口疏密时要看人口密度，而不能只看人口数量？",
          "options": [],
          "answer_index": null,
          "expected_points": ["面积不同数量不可直接比较", "密度反映单位面积人口"],
          "misconceptions": [
            {"tag": "混淆数量与密度", "description": "认为人口多的地区密度一定高，忽略区域面积差异"}
          ]
        },
        {
          "question_id": "s2q2",
          "type": "choice",
          "text": "甲区域人口 500 万、面积 50 万平方千米；乙区域人口 300 万、面积 10 万平方千米。下列说法正确的是？",
          "options": ["甲区域人口密度更高", "乙区域人口密度更高", "两区域人口密度相同", "人口多的区域密度一定高"],
          "answer_index": 1,
          "expected_points": ["密度=人口÷面积", "乙 30 人/km² 大于甲 10 人/km²"],
          "misconceptions": [
            {"tag": "混淆数量与密度", "description": "直接用人口总数判断疏密，没有除以面积"}
          ]
        }
      ],
      "assistant_prompts": ["请用高中生能听懂的方式解释人口数量与人口密度的区别，并结合当前密度图举一个例子。"]
    },
    {
      "stage_id": "s3",
      "title": "数据探究：2020 年地级市人口 Top20",
      "minutes": 6,
      "scene": {
        "basemap_id": "amap_light",
        "templates": [],
        "layer_visibility": {
          "builtin_population_regions": false,
          "builtin_population_density": false,
          "builtin_population_migration": false,
          "generated_hu_line": false
        },
        "view": {"center": [107.0, 33.0], "zoom": 4},
        "annotations": [],
        "visual_query": {
          "dataset": "prefecture_population",
          "metric": "population",
          "operation": "top",
          "year": 2020,
          "limit": 20,
          "order": "desc",
          "geo_level": "prefecture"
        }
      },
      "script": [
        "现在系统按七普数据查询出 2020 年人口最多的 20 个地级市，并在地图上高亮。",
        "小组任务：观察这 20 个城市的位置，它们在空间上有什么共同点？"
      ],
      "questions": [
        {
          "question_id": "s3q1",
          "type": "open",
          "text": "人口 Top20 的地级市在空间分布上有哪些共同特征？",
          "options": [],
          "answer_index": null,
          "expected_points": ["多位于东部沿海或平原", "多为省会/直辖市等经济中心", "基本都在胡焕庸线东南侧"],
          "misconceptions": [
            {"tag": "以行政级别代替区位", "description": "只回答“都是大城市/省会”，没有落到地形、沿海、经济区位等空间证据"}
          ]
        }
      ],
      "assistant_prompts": ["请根据当前高亮的人口Top20城市，引导学生归纳它们的区位共性。"]
    },
    {
