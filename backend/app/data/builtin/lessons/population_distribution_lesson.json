      "script": [
        "影响人口分布的因素分两类：自然因素（气候、地形、水源、土壤、矿产）与人文因素（经济、交通、历史开发、政策、生产方式、文化）。",
        "小组任务：每组选择一个因素，用“因素-地图证据-解释”的句式表达。"
      ],
      "questions": [
        {
          "question_id": "s5q1",
          "type": "open",
          "text": "选择一个影响因素，用“因素-地图证据-解释”说明它如何影响中国人口分布。",
          "options": [],
          "answer_index": null,
          "expected_points": ["气候：东部季风区水热好", "地形：平原开发难度小", "水源：干旱区沿河沿绿洲", "经济：就业机会吸引集聚", "交通：便利地区集聚"],
          "misconceptions": [
