# ── LLM provider ─────────────────────────────────────────────
# "minimax" (Anthropic-compatible API, recommended) or "mimo" (legacy).
# When omitted: uses minimax if MINIMAX_API_KEY is set, else mimo.
AGENT_LLM_PROVIDER=minimax

# MiniMax Anthropic-compatible API (recommended)
# Docs: https://platform.minimaxi.com/docs/api-reference/text-anthropic-api
MINIMAX_API_KEY=your-minimax-api-key-here
MINIMAX_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M2.7-highspeed

# Xiaomi MiMo LLM API (legacy fallback)
#MIMO_API_KEY=your-api-key-here
#MIMO_BASE_URL=https://api.xiaomimimo.com/v1
#MIMO_MODEL=mimo-v2.5-pro

# WebGIS Backend (optional, for GIS tools)
WEBGIS_BACKEND_URL=http://127.0.0.1:18999

# Agent settings (optional)
AGENT_MAX_TURNS=50
AGENT_MAX_TOKENS=4096
AGENT_TEMPERATURE=0.2
AGENT_AUTO_APPROVE=true
