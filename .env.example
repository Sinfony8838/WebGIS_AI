# WebGIS-AI configuration reference. Fill only the services you use.
# The current launcher/backend do not auto-load a repository-root .env file.
# Export WEBGIS_AI_* variables to the process/user environment; put VITE_* values
# in frontend/.env.local (or export them before npm runs). Never commit real secrets.

# Core service
WEBGIS_AI_HOST=127.0.0.1
WEBGIS_AI_PORT=18999
WEBGIS_AI_CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_API_BASE_URL=http://127.0.0.1:18999

# Accounts and deployment security
WEBGIS_AI_AUTH_MODE=users
WEBGIS_AI_REGISTRATION_MODE=approval
WEBGIS_AI_COOKIE_SECURE=false
WEBGIS_AI_SESSION_IDLE_MINUTES=480
WEBGIS_AI_SESSION_MAX_HOURS=24
WEBGIS_AI_BOOTSTRAP_KEY=
# Enable only behind a trusted proxy that overwrites CF-Connecting-IP.
WEBGIS_AI_TRUST_PROXY_HEADERS=false
# Used only by backend/API clients when WEBGIS_AI_AUTH_MODE=legacy_token.
# The current browser UI does not inject this token into ordinary API calls.
# WEBGIS_AI_AUTH_TOKEN=replace-with-a-long-random-token
# WEBGIS_AI_AUTH_EXEMPT_PATHS=

# MiniMax is the only supported LLM provider.
WEBGIS_AI_LLM_PROVIDER=minimax
WEBGIS_AI_MINIMAX_API_KEY=
WEBGIS_AI_MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
WEBGIS_AI_MINIMAX_MODEL=MiniMax-M2.7-highspeed
WEBGIS_AI_MINIMAX_IMAGE_BASE_URL=https://api.minimaxi.com
WEBGIS_AI_MINIMAX_IMAGE_MODEL=image-01
WEBGIS_AI_VISION_ENABLED=false
WEBGIS_AI_VISION_PROVIDER=minimax_mcp
WEBGIS_AI_VISION_MODEL=

# Optional online map services
WEBGIS_AI_AMAP_WEB_SERVICE_KEY=
# WEBGIS_AI_AMAP_POI_POLYGON_URL=https://restapi.amap.com/v3/place/polygon
WEBGIS_AI_OPENWEATHERMAP_API_KEY=

# Optional QGIS installation. The launcher can derive Python from the root.
WEBGIS_AI_QGIS_ROOT=
# Alternatively set QGIS_ROOT instead of WEBGIS_AI_QGIS_ROOT.
WEBGIS_AI_QGIS_PREFIX_SUBPATH=apps/qgis-ltr
WEBGIS_AI_QGIS_PYTHON=

# Local streaming ASR. Leave model paths empty to use the shared default cache.
WEBGIS_AI_VOICE_ASR_ENABLED=true
WEBGIS_AI_VOICE_MODEL_DIR=
WEBGIS_AI_VOICE_MODEL_STABLE_ROOT=

# Optional external teaching-resource search service
WEBGIS_AI_RESOURCE_SEARCH_ENDPOINT=
